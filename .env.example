# Web UI bind. Keep localhost-only and use SSH forwarding, or set to the VPS
# WireGuard IP (for example 10.88.0.2) when browsers can reach that VPN address.
APP_BIND=127.0.0.1
APP_PORT=8080

# Generate a long random value for production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0

# Add every hostname/IP used to open the app, comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
