# Example for a Linux WireGuard gateway on the router LAN. Install on the LAN
# host as /etc/wireguard/wg0.conf, replace keys/interface names, then:
#   chmod 600 /etc/wireguard/wg0.conf
#   systemctl enable --now wg-quick@wg0
#
# Replace eth0 with the interface connected to the Nokia router subnet.

[Interface]
PrivateKey = REPLACE_WITH_LAN_PRIVATE_KEY
Address = 10.88.0.1/24
ListenPort = 51820
MTU = 1420

# Forward VPS traffic onto the router LAN and masquerade it as this LAN host,
# so the Nokia units can return replies without a route to 10.88.0.0/24.
PostUp = sh -c "sysctl -w net.ipv4.ip_forward=1 && iptables -A FORWARD -i %i -o eth0 -j ACCEPT && iptables -A FORWARD -i eth0 -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT && iptables -t nat -A POSTROUTING -s 10.88.0.0/24 -o eth0 -j MASQUERADE"
PostDown = sh -c "iptables -D FORWARD -i %i -o eth0 -j ACCEPT; iptables -D FORWARD -i eth0 -o %i -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT; iptables -t nat -D POSTROUTING -s 10.88.0.0/24 -o eth0 -j MASQUERADE"

[Peer]
# Public key generated on the VPS.
PublicKey = REPLACE_WITH_VPS_PUBLIC_KEY
AllowedIPs = 10.88.0.2/32
