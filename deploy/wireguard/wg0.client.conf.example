# Copy to /etc/wireguard/wg0.conf on the VPS, replace the placeholders, then:
#   chmod 600 /etc/wireguard/wg0.conf
#   systemctl enable --now wg-quick@wg0
#
# The remote/LAN-side WireGuard peer must route the router subnet back to this
# VPS tunnel IP, or SNAT traffic from the tunnel onto the router LAN.

[Interface]
# Private key generated on the VPS with: wg genkey
PrivateKey = REPLACE_WITH_VPS_PRIVATE_KEY
# This VPS's address inside the WireGuard network.
Address = 10.88.0.2/32
MTU = 1420

[Peer]
# Public key of the WireGuard peer on the router LAN.
PublicKey = REPLACE_WITH_LAN_PEER_PUBLIC_KEY
# Public endpoint of the LAN-side WireGuard peer.
Endpoint = lan-vpn.example.com:51820
# Include every router subnet the backend must reach.
AllowedIPs = 10.88.0.0/24, 192.168.1.0/24
PersistentKeepalive = 25
